<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_employee_form_view_ext" model="ir.ui.view">
            <field name="name">hr.employee.form.ext</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                  <xpath expr="//group[@name='identification_group']" position="inside">
                        <label for="allowed_discount_percentage"/>
                        <div name="allowed_discount_percentage" class="o_row">
                            <field name="allowed_discount_percentage" modifiers="{}"/>%
                        </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
