<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="l10n_gt_extra_account_move_form_view" model="ir.ui.view">
        <field name="name">l10n_gt_extra_account_move_form_view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <button name="button_cancel" position="after">
                <field name="isr_withold_exclude_calculated" invisible="1"/>
                <field name="iva_withold_exclude_calculated" invisible="1"/>
                <button name="check_isr_iva_lines" invisible="state != 'draft'" string="Actualizar Impuestos" type="object"/>
                <button name="remove_isr_withold_lines" string="Quitar ISR" type="object" invisible="isr_withold_amount == 0 or state != 'draft' or isr_withold_exclude_calculated"/>
                <button name="remove_iva_withold_lines" string="Quitar Exención de IVA" type="object" invisible="iva_withold_amount == 0 or state != 'draft' or iva_withold_exclude_calculated"/>
            </button>
            <field name="ref" position="after">
                <field name="move_type" invisible="1"/>
                <field name="type_invoice" invisible="1"/>
                <field name="provider_invoice_serial" placeholder="Serie" invisible="move_type not in ('in_invoice','in_refund')" required="move_type in ('in_invoice','in_refund') and type_invoice != 'FESP'"/>
                <field name="provider_invoice_number" placeholder="Número" invisible="move_type not in ('in_invoice','in_refund')" required="move_type in ('in_invoice','in_refund') and type_invoice != 'FESP'"/>
                <field name="isr_withold_amount" invisible="1" />
                <field name="iva_withold_amount" invisible="1" />
            </field>
        </field>
    </record>

    <record id="l10n_gt_extra_account_move_tree_view" model="ir.ui.view">
        <field name="name">l10n_gt_extra_account_move_tree_view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">  
            <field name="amount_tax_signed" position="after">
                <field name="isr_withold_amount" readonly="1" optional="hide"/>
                <field name="iva_withold_amount" readonly="1" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="account_invoice_view_tax_extra_info" model="ir.ui.view">
        <field name="name">account_invoice_view_tax_extra_info</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="amount_total" position="before">
                <field name="iva_withold_amount" invisible="iva_withold_amount == 0 or iva_withold_exclude_calculated" readonly="state != 'draft'"/>
                <field name="tax_withholding_iva" invisible="1" />
                <field name="tax_withholding_isr" invisible="1" />
                <field name="user_country_id" invisible="1" />
                <field name="isr_withold_amount" invisible="isr_withold_amount == 0 or isr_withold_exclude_calculated" readonly="state != 'draft'"/>
                <field name="tax_withholding_amount_isr" invisible="1" />
                <field name="tax_withholding_amount_iva" invisible="1" />
            </field>
            <field name="fiscal_position_id" position="after">
                <field name="tipo_gasto" readonly="1"/>
                <field name="isr_withold_exclude_calculated" invisible="state != 'draft'"/>
                <field name="iva_withold_exclude_calculated" invisible="state != 'draft'"/>
            </field>
            <xpath expr="//page[@id='other_tab']" position="after">
                <page name="ref_analytic_line_ids_page" string="Apuntes analíticos" invisible="show_analytic_lines != True">
                    <field name="show_analytic_lines" invisible="1" />
                    <field name="ref_analytic_line_ids">
                        <tree>
                            <field name="account_id" />
                            <field name="name" />
                            <field name="currency_id" />
                            <field name="amount" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
