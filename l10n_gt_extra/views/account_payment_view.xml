<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="l10n_gt_extra_view_account_payment_form" model="ir.ui.view">
        <field name="name">l10n_gt_extra.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <data>
                <button name="action_draft" position="after">
                    <button name="action_discarded" invisible="payment_method_code != 'check_printing' or state != 'posted'" string="Anular" type="object"/>
                </button>
                <field name="ref" position="after">
                    <field name="bank_concept"/>
                    <field name="printed_check_name" invisible="payment_type != 'outbound'"/>
                    <field name="not_negociable" invisible="payment_type != 'outbound'"/>
                </field>
            </data>
        </field>
    </record>

</odoo>
