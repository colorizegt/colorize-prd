    <record id="asistente_reporte_financiero" model="ir.ui.view">
        <field name="name">l10n_gt_extra.asistente_reporte_financiero</field>
        <field name="model">l10n_gt_extra.asistente_reporte_financiero</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Seleccione tipo, rango de fecha y diarios para el reporte">
                <group>
                    <group>
                        <field name="report_type"/>
                        <field name="folio_inicial"/>
                    </group>
                    <group>
                        <field name="start_date" invisible="report_type in ('balance')"/>
                        <field name="end_date"/>
                    </group>
                </group>
                <footer>
                    <button name="print_report_pdf" string="Reporte PDF" type="object" class="oe_highlight" />
                    <button special="cancel" string="Cancelar" class="oe_link" />
                </footer>
            </form>
        </field>
