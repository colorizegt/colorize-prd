    <record id="check_report_view_form" model="ir.ui.view">
        <field name="name">l10n_gt_extra.check_report</field>
        <field name="model">l10n_gt_extra.check_report</field>
        <field name="arch" type="xml">
            <form string="Reporte de Cheques">
            <sheet>
            <div class="oe_title">
                <h1>Reporte de Cheques</h1>
            </div>
            <group>
                <field name="journal_id" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" options="{'no_create': True, 'no_create_edit':True}"/>
            </group>
            </sheet>
            <footer>
                <button name="export_xls" string="Reporte Excel" type="object" class="oe_highlight"/>
                <button string="Cancel" class="btn-default" special="cancel"/>
            </footer>
                </form>
        </field>
    </record>

    <record id="window_check_report" model="ir.actions.act_window">
        <field name="name">Reporte de Cheques</field>
        <field name="res_model">l10n_gt_extra.check_report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="check_report_view_form"/>
        <field name="target">new</field>
    </record>

