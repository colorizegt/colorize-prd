<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Plantilla para numeración de páginas en reportes -->
    <template id="l10n_gt_extra_minimal" inherit_id="web.minimal_layout">
        <script position="replace">
            <script>
                function subst() {
                    var vars = {};
                    var x = document.location.search.substring(1).split('&amp;');
                    for (var i in x) {
                        var z = x[i].split('=', 2);
                        vars[z[0]] = unescape(z[1]);
                    }
                    var fromPage = document.getElementsByClassName('page');
                    for(var j = 0; j&lt;fromPage.length; j++) {
                        var offset = fromPage[j].textContent || 0;
                        fromPage[j].textContent = parseInt(vars['sitepage']) + parseInt(offset);
                    }
                    var toPage = document.getElementsByClassName('topage');
                    for(var j = 0; j&lt;toPage.length; j++) {
                        var offset = fromPage[j].textContent || 0;
                        toPage[j].textContent = vars['sitepages'];
                    }
                    var index = vars['webpage'].split('.', 4)[3];
                    var header = document.getElementById('minimal_layout_report_headers');
                    if(header !== null){
                        var companyHeader = header.children[index];
                        header.textContent = '';
                        header.appendChild(companyHeader);
                    }
                    var footer = document.getElementById('minimal_layout_report_footers');
                    if(footer !== null){
                        var companyFooter = footer.children[index];
                        footer.textContent = '';
                        footer.appendChild(companyFooter);
                    }
                }
            </script>
        </script>
    </template>
    
    <!-- Menú de informes -->
    <menuitem 
        id="menu_informes" 
        name="Informes de Guatemala" 
        parent="account.menu_finance_reports"
    />

    <!-- Reporte de Banco -->
    <record id="asistente_reporte_banco" model="ir.ui.view">
        <field name="name">l10n_gt_extra.asistente_reporte_banco</field>
        <field name="model">l10n_gt_extra.asistente_reporte_banco</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Seleccione cuenta y rango de fecha">
                <group>
                    <group>
                        <field name="cuenta_bancaria_id"/>
                    </group>
                    <group>
                        <field name="fecha_desde"/>
                        <field name="fecha_hasta"/>
                    </group>
                </group>
                <footer>
                    <button name="print_report" string="Reporte" type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window 
        id="window_reporte_banco" 
        name="Libro de banco" 
        res_model="l10n_gt_extra.asistente_reporte_banco" 
        binding_model="account.account" 
        view_mode="form" 
        target="new"
    />
    
    <menuitem 
        action="window_reporte_banco" 
        id="menu_asistente_reporte_banco" 
        parent="menu_informes"
    />
    
    <report 
        id="action_reporte_banco" 
        model="l10n_gt_extra.asistente_reporte_banco" 
        string="Libro de banco" 
        report_type="qweb-pdf" 
        name="l10n_gt_extra.reporte_banco" 
        file="l10n_gt_extra.reporte_banco"
    />

    <!-- Reporte de Partida -->
    <report 
        id="action_reporte_partida" 
