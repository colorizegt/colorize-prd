                                </td>
                                <!--<td class="text-end"><span t-esc="result['totales']['importacion']['iva']" t-options="{'widget': 'monetary', 'display_currency': user.company_id.currency_id}"/></td><td class="text-end"><span t-esc="result['totales']['compra']['iva']" t-options="{'widget': 'monetary', 'display_currency': user.company_id.currency_id}"/></td><td class="text-end"><span t-esc="result['totales']['servicio']['iva']" t-options="{'widget': 'monetary', 'display_currency': user.company_id.currency_id}"/></td><td class="text-end"><span t-esc="result['totales']['combustible']['iva']" t-options="{'widget': 'monetary', 'display_currency': user.company_id.currency_id}"/></td>-->
