                                <th class="text-center" style="border: 0.5px solid #000">Tipo Doc.</th>
                                <th class="text-center" style="border: 0.5px solid #000">Serie</th>
                                <th class="text-center" style="border: 0.5px solid #000">Doc</th>
                                <th class="text-center" style="border: 0.5px solid #000">NIT</th>
                                <th class="text-center" style="border: 0.5px solid #000; width: 25%;">Nombre</th>
                                <th class="text-center" style="border: 0.5px solid #000">Importaciones</th>
                                <th class="text-center" style="border: 0.5px solid #000">Bienes</th>
                                <th class="text-center" style="border: 0.5px solid #000">Servicios</th>
                                <th class="text-center" style="border: 0.5px solid #000">Combustibles</th>
