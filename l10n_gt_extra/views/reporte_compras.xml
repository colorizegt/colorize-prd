                                        <td class="text-end">
                                            <span t-esc="iva_subtotal" t-options="{'widget': 'monetary', 'display_currency': user.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="small_taxpayer_amount_subtotal" t-options="{'widget': 'monetary', 'display_currency': user.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-end">
