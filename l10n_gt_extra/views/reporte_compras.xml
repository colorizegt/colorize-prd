                                <th class="text-center" rowspan="2" scope="col" style="border: 0.5px solid #000; vertical-align:middle;">Pequeño Contribuyente</th>
                                <th class="text-center" rowspan="2" scope="col" style="border: 0.5px solid #000; vertical-align:middle;">Compras Extentas</th>
                                <th class="text-center" rowspan="2" scope="col" style="border: 0.5px solid #000; vertical-align:middle;">Total</th>
                            </tr>
                            <tr style="border: 0.5px solid #000">
