                                        </td>
                                        <td class="text-end">
                                            <span t-esc="total_subtotal" t-options="{'widget': 'monetary', 'display_currency': user.company_id.currency_id}"/>
                                        </td>
                                        <t t-set="j" t-value="-1"/>
                                    </tr>
                                    <tr>
                                        <td/>
                                        <td/>
                                        <td/>
                                        <td/>
                                        <td/>
                                        <td/>
                                        <td>Vienen
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="importacion_subtotal" t-options="{'widget': 'monetary', 'display_currency': user.company_id.currency_id}"/>
