                            </div>
                            <div class="ml-3 pl-3">
                                <div t-if="company_id.vat != False">
                                    <span t-esc="company_id.vat"/>
                                </div>
                                <div t-if="company_id.vat == False">
                                    -----
                                </div>
                            </div>
                        </div>
                    </div>
