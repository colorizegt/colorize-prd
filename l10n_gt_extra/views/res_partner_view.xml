<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record model="ir.ui.view" id="l10n_gt_extra.l10n_gt_view_res_partner_filter">
            <field name="name">l10n_gt_extra.l10n_gt_view_res_partner_filter</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="vat" string="NIT" select="1" />
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="partner_view_tax_withholding">
            <field name="name">res.partner.tax_withholding</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/group" position="after">
                    <div class="oe_inline">
                        <label for="tax_withholding_isr" class="col-form-label">Retención ISR</label>
                        <field name="tax_withholding_isr" widget="selection" invisible="parent_id"/>
                    </div>
                    <div class="oe_inline">
                        <label for="tax_withholding_iva" class="col-form-label">Retención ISR</label>
                        <field name="tax_withholding_iva" widget="selection" invisible="parent_id"/>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
