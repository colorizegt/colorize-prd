<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="multicert_felgt_account_tax_form_view_inherit" model="ir.ui.view">
        <field name="name">multicert_felgt.account.tax.form.inherit</field>
        <field name="active">True</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="fel_gt_timbre_tax"/>
                <field name="fel_gt_tax"/>
                <field name="fel_gt_idp_tax_type" invisible="fel_gt_tax != 'PETROLEO'"/>
            </field>
        </field>
    </record>
    
</odoo>