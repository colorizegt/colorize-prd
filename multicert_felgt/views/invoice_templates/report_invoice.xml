<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="fel_gt_report_invoice_document" inherit_id="account.report_invoice_document" primary="True">
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.fel_gt_dte_number" name="dte_number">
                <strong>Número DTE:</strong><br/>
                <span t-if="o.fel_gt_dte_number" t-field="o.fel_gt_dte_number">INV/2023/0001</span>
            </div>
            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.fel_gt_serie" name="serie">
                <strong>Serie FEL:</strong><br/>
                <span t-if="o.fel_gt_serie" t-field="o.fel_gt_serie">INV/2023/0001</span>
            </div>
        </xpath>

        <xpath expr="//div[@id='payment_term']" position="after">
            <t t-call="multicert_felgt.report_invoice_fel_certifier"/>
        </xpath>
    </template>

    <template id="report_invoice" inherit_id="account.report_invoice">
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
            <t t-elif="o._get_name_invoice_report() == 'multicert_felgt.fel_gt_report_invoice_document'"
               t-call="multicert_felgt.fel_gt_report_invoice_document"
               t-lang="lang"/>
            <t t-elif="o._get_name_invoice_report() == 'multicert_felgt.fel_gt_report_invoice'"
               t-call="multicert_felgt.fel_gt_report_invoice"
               t-lang="lang"/>
        </xpath>
    </template>

</odoo>
