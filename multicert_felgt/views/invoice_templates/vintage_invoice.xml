<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--template id="template_invoice_style" inherit_id="web.report_assets_common">
        <xpath expr=".">
            <link href="/multicert_felgt/static/src/css/template.css" rel="stylesheet"/>
        </xpath>
    </template-->
    <template id="template_external_layout">
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="multicert_felgt.template_header"/>
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <t t-call="multicert_felgt.template_footer"/>
    </template>
    <template id="template_header">
        <div class="header" t-att-style="'font-family:'+o.company_id.fel_gt_font_id.family+';font-size:'+str(o.company_id.fel_gt_font_size)+'px;'">
            <table class="table table-borderless" border="0" cellpadding="0" cellspacing="0" width="100%">
                <tbody>
                    <tr>
                        <td>
                            <center>
                                <table class="table table-borderless" border="0" cellpadding="0" cellspacing="0" width="100%">
                                    <tr>
                                        <td align="left" colspan="2" valign="top">
                                            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                <tr>
                                                    <td align="left" valign="middle">
                                                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                            <tr>
                                                                <td align="left" valign="middle">
                                                                    <t t-if="o.journal_id.fel_gt_custom_logo">
                                                                        <t t-if="o.journal_id.fel_gt_invoice_custom_logo">
                                                                            <img t-attf-src="data:image/*;base64,{{o.journal_id.fel_gt_invoice_custom_logo}}" style="max-height: 80px;"/>
                                                                        </t>
                                                                    </t>
                                                                    <t t-elif="o.company_id.fel_gt_invoice_logo">
                                                                        <img t-att-src="image_data_uri(o.company_id.fel_gt_invoice_logo)" style="max-height: 80px;" t-if="o.company_id.fel_gt_invoice_logo"/>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <t t-if="o.company_id.logo">
                                                                            <img src="/web/binary/company_logo" style="max-height: 80px;"/>
                                                                        </t>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td align="right" rowspan="3" style="width:60%;">
                                                        <p t-attf-style="color: #{o.company_id and o.company_id.fel_gt_theme_text_color or '#000000'};background-color: #{o.company_id and o.company_id.fel_gt_theme_color or '#000000'}; text-align:center; text-transform:uppercase; padding:5px 0px; width:60%;font-size:14px">
                                                            <t t-if="o.fel_gt_uuid or o.fel_gt_contingency_access_number">
                                                                <t t-if="o.fel_gt_uuid">
                                                                    <strong style="font-size:12px;" class="text-justify">DOCUMENTO TRIBUTARIO ELECTRÓNICO</strong><br/>
                                                                </t>
                                                                <t t-else="">
                                                                    <strong style="font-size:12px;" class="text-justify">DOCUMENTO EN CONTINGENCIA</strong><br/>
                                                                </t>
                                                                <span t-esc="o._fel_gt_invoice_name()"/>
                                                            </t>
                                                            <t t-else="">
                                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Factura</span>
                                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Factura en Borrador</span>
                                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Factura Cancelada</span>
                                                                <span t-if="o.move_type == 'out_refund'">Nota de Credito</span>
                                                                <span t-if="o.move_type == 'in_refund'">Nota de Credito Proveedor</span>
                                                                <span t-if="o.move_type == 'in_invoice'">Factura Proveedor</span>
                                                            </t>
                                                        </p>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </center>
                        </td>
                    </tr>
                </tbody>
            </table>
            
        </div>
    </template>
    <template id="report_invoice_template_main">
        <t t-call="multicert_felgt.template_external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
            <t t-set="theme_color" t-value="o.company_id and o.company_id.fel_gt_theme_color"/>
            <t t-set="theme_text_color" t-value="o.company_id and o.company_id.fel_gt_theme_text_color"/>
            <t t-set="company_color" t-value="o.company_id and o.company_id.fel_gt_company_color"/>
            <t t-set="company_address_color" t-value="o.company_id and o.company_id.fel_gt_company_address_color"/>
            <t t-set="customer_color" t-value="o.company_id and o.company_id.fel_gt_customer_color"/>
            <t t-set="customer_address_color" t-value="o.company_id and o.company_id.fel_gt_customer_address_color"/>
            <t t-set="text_color" t-value="o.company_id and o.company_id.fel_gt_text_color"/>
            <div class="page" t-att-style="'font-family:'+o.company_id.fel_gt_font_id.family+';font-size:'+str(o.company_id.fel_gt_font_size)+'px;'">
                <div class="oe_structure"/>
                <t t-call="multicert_felgt.template_watermark"/>
                <div border="0" cellpadding="0" cellspacing="0" width="100%">
                    <div class="container-fluid">
                        
                        <div class="row" valign="top" >
                            <div class="col-4" colspan="1" style="margin-top:15px;">
                                <div style="margin-right:15px;background-color:#C0C0C0; height:20px;border: 2px solid #C0C0C0;border-radius: 10px;padding: 5px;"></div>
                            </div>
                            <div class="col-8" t-attf-style="color: #{o.company_id and o.company_id.fel_gt_theme_text_color or '#000000'};font-weight:bold; background-color: #{o.company_id and o.company_id.fel_gt_theme_color or '#000000'};">
                                <table class="table table-borderless">
                                    <tr t-attf-style="color: #{o.company_id and o.company_id.fel_gt_theme_text_color or '#000000'};font-weight:bold;background-color: #{o.company_id and o.company_id.fel_gt_theme_color or '#000000'};">
                                        <td t-if="o.move_type == 'out_invoice'">
                                            <b>Fecha Factura:</b>
                                            <span t-esc="o._get_fel_gt_invoice_date()"/>
                                        </td>
                                        <t t-if="o.fel_gt_uuid or o.fel_gt_contingency_access_number">
                                            <t t-if="o.fel_gt_uuid">
                                                <td>
                                                    <b>Número DTE:</b>
                                                    <span t-field="o.fel_gt_dte_number"/>
                                                </td>
                                                <td>
                                                    <b>Serie FEL:</b>
                                                    <span t-field="o.fel_gt_serie"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td>
                                                    <b>Número Contingencia:</b>
                                                    <span t-field="o.fel_gt_contingency_access_number"/>
                                                </td>
                                            </t>
                                        </t>
                                        <t t-if="o.company_id.fel_gt_invoice_show_invoice_ref">
                                            <t t-if="o.name">
                                                <td>
                                                    <b>Referencia:</b>
                                                    <span t-field="o.name"/>
                                                </td>
                                            </t>
                                        </t>
                                        <td t-if="o.invoice_origin and o.company_id.fel_gt_invoice_show_origin_order_name">
                                            <b>Origen:</b>
                                            <span t-esc="o.invoice_origin"/>
                                        </td>
                                        <td t-if="o._get_fel_gt_origin_date(o.invoice_origin) and o.company_id.fel_gt_invoice_show_origin_order_date">
                                            <b>Fecha Orden Origen:</b>
                                            <span t-esc="o._get_fel_gt_origin_date(o.invoice_origin)"/>
                                        </td>
                                        <td t-if="o._get_fel_gt_invoice_due_date() and o.company_id.fel_gt_invoice_show_invoice_date_due">
                                            <b>Fecha Vencimiento:</b>
                                            <span t-esc="o._get_fel_gt_invoice_due_date()"/>
                                        </td>
                                        <td t-if="o.partner_id.ref and o.company_id.fel_gt_invoice_show_customer_code">
                                            <b>Código Cliente:</b>
                                            <span t-esc="o.partner_id.ref"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div>
                            <p t-attf-style="border-bottom:1px solid #{theme_color or '#ececec'}; padding:5px"/>
                        </div>
                        <div class="row">
                            
                            
                            <div class="col-5">
                                <t t-call="multicert_felgt.invoice_templates_customer_details"/>
                            </div>
                            <div class="col-4">
                                <t t-call="multicert_felgt.invoice_templates_customer_shipping_details"/>
                            </div>
                            <div class="col-3">
                                <span t-attf-style="color: #{theme_color or '#ffffff'}; font-weight:bold;">Emisor:</span><br/>
                                <t t-call="multicert_felgt.templates_company_details"/>
                            </div>
                        </div>
                        <div>
                            <p t-attf-style="border-bottom:1px solid #{theme_color or '#ececec'}; padding:5px"/>
                        </div>
                        <div style="padding:5px 0px 0 0; font-weight:bold; width:100%;" >
                            <t t-call="multicert_felgt.report_invoice_order_lines"/>
                        </div>
                        <div>
                            <t t-call="multicert_felgt.invoice_subtotal_tem" />
                        </div>
                        <div t-attf-style="border-bottom:1px solid #{'#959595'}; padding:0px">
                            <t t-call="multicert_felgt.template_total_amount_word"/>
                        </div>
                        <div t-if="not o._compute_payments_widget_reconciled_info() and not o.company_id.fel_gt_invoice_hide_payment_status">
                            <p t-att-style="'font-weight:bold; color:#000; margin-bottom:0; text-transform:capitalize; margin-top:8px; color: %s;' % (text_color)">
                            Estado del Pago: 
                                <span t-esc="dict(o._fields['payment_state']._description_selection(o.env)).get(o.payment_state)"/>
                            </p>
                        </div>
                        <div class="pull-left" style="color: #{text_color or '#000000'}; padding-top:5px; ">
                            <t t-call="multicert_felgt.report_invoice_notes"/>
                        </div>
                        <div align="right"  style="color: #{text_color or '#000000'};">
                            <t t-call="multicert_felgt.report_invoice_signature"/>
                        </div>
                        <div class="oe_structure"/>
                        <t t-call="multicert_felgt.report_invoice_barcode"/>
                        <t t-call="multicert_felgt.report_invoice_fel_certifier"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="report_invoice_template_custom">
        <t t-call="web.html_container">
            <t t-as="o" t-foreach="docs">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-call="multicert_felgt.report_invoice_template_main" t-lang="lang"/>
            </t>
        </t>
    </template>
    <template id="report_invoice_template_main_duplicate" inherit_id="multicert_felgt.report_invoice_template_main" primary="True">
       <!--  <xpath expr="//div[@t-if='not o._compute_payments_widget_reconciled_info()'] " position="before">
            <t t-call="multicert_felgt.report_invoice_payment_move_line"/>
        </xpath> -->
    </template>
    <template id="fel_gt_report_invoice">
        <t t-call="web.html_container">
            <t t-as="o" t-foreach="docs">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-set="r_name" t-value="o.fel_gt_report_template_id and o.fel_gt_report_template_id.report_name or o.partner_id and o.partner_id.fel_gt_report_template_id and o.partner_id.fel_gt_report_template_id.report_name or o.company_id and o.company_id.fel_gt_report_template_id and o.company_id.fel_gt_report_template_id.report_name"/>
                <t t-set="real_name" t-value="r_name.split('.')"/>
                <t t-if="o.fel_gt_report_template_id or o.partner_id and o.partner_id.fel_gt_report_template_id or o.company_id and o.company_id.fel_gt_report_template_id">
                    <t t-call="multicert_felgt.report_invoice_template_main" t-if="r_name == 'multicert_felgt.report_invoice_template_custom'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_advanced_main" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_advanced'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_elegant_main" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_elegant'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_exclusive_main" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_exclusive'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_creative_main" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_creative'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_incredible_main" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_incredible'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_template_infile_classic" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_infile_classic'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_template_odoo" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_odoo'" t-lang="lang"/>
                </t>
            </t>
        </t>
    </template>
    <template id="fel_gt_report_invoice_with_payments">
        <t t-call="web.html_container">
            <t t-as="o" t-foreach="docs">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-set="print_with_payments" t-value="True"/>
                <t t-set="r_name" t-value="o.fel_gt_report_template_id and o.fel_gt_report_template_id.report_name or o.partner_id and o.partner_id.fel_gt_report_template_id and o.partner_id.fel_gt_report_template_id.report_name or o.company_id and o.company_id.fel_gt_report_template_id and o.company_id.fel_gt_report_template_id.report_name"/>
                <t t-set="real_name" t-value="r_name.split('.')"/>
                <t t-if="o.fel_gt_report_template_id or o.partner_id and o.partner_id.fel_gt_report_template_id or o.company_id and o.company_id.fel_gt_report_template_id">
                    <t t-call="multicert_felgt.report_invoice_template_main_duplicate" t-if="r_name == 'multicert_felgt.report_invoice_template_custom'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_advanced_main_duplicate" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_advanced'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_elegant_main_duplicate" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_elegant'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_exclusive_main_duplicate" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_exclusive'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_creative_main_duplicate" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_creative'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_incredible_main_duplicate" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_incredible'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_template_infile_classic_duplicate" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_infile_classic'" t-lang="lang"/>
                    <t t-call="multicert_felgt.report_invoice_template_odoo_duplicate" t-if="r_name == 'multicert_felgt.report_invoice_template_custom_odoo'" t-lang="lang"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
