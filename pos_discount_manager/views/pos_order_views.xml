<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_order_form_discount_authorization" model="ir.ui.view">
        <field name="name">pos.order.form.discount.authorization</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='user_id']" position="after">

                <field name="discount_authorized"/>

                <field name="discount_manager_id"
                       invisible="not discount_authorized"/>

                <field name="discount_authorized_at"
                       invisible="not discount_authorized"/>

            </xpath>

        </field>
    </record>

</odoo>
