<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension" owl="1">
        <xpath expr="//td[3]" position="after">
            <t t-if="pos.isGuatemalanCompany()">
                <td>
                    <t t-esc="props.partner.vat or ''" />
                </td>
                <td>
                    <t t-esc="props.partner.fel_gt_dpi_number or ''" />
                </td>
                <td>
                    <t t-esc="props.partner.fel_gt_passport_number or ''" />
                </td>
            </t>
        </xpath>
    </t>

</templates>