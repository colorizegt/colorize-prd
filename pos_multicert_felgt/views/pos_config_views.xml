<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_multicert_felgt.pos_config_inherit" model="ir.ui.view">
        <field name="name">pos_multicert_felgt.pos_config_inherit</field>
        <field name="model">pos.config</field>
        <field name="active">True</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="fel_gt_active" invisible="1"/>
                <field name="fel_gt_pos_custom_logo" widget='image' class="oe_avatar" invisible='not fel_gt_active'/>
            </field>
        </field>
    </record>
</odoo>